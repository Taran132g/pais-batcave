[Unit]
Description=PAIS cave API (getpais.company private dashboard)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/pais-cave
Environment=PAIS_COOKIE_DOMAIN=getpais.company
ExecStart=/home/ubuntu/pais-cave/.venv/bin/python -m cave.app
Restart=always
RestartSec=5
MemoryMax=150M

[Install]
WantedBy=multi-user.target
